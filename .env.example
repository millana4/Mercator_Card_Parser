# Режим
DEBUG=false
LOG_LEVEL=INFO
DEBUG_DIR=app/debug
API_PREFIX=/api/v1

# Ключ межсервисной авторизации
SERVICE_API_KEY=string

PARSER_MARKETPLACES=ozon

OZON_GEO_CODE=spb
OZON_GEO_NAME=Санкт-Петербург

# --- Политика Ozon
OZON_HEADLESS=true
OZON_PAGE_LOAD_TIMEOUT=30
OZON_WAIT_TIMEOUT=15
OZON_PAUSE_MIN=15
OZON_PAUSE_MAX=30
OZON_RETRIES=2
OZON_RETRY_PAUSE_MIN=60.0
OZON_RETRY_PAUSE_MAX=80.0
OZON_BETWEEN_CARDS_MIN=60
OZON_BETWEEN_CARDS_MAX=80
OZON_RESERVE_BETWEEN_CARDS_MIN=50
OZON_RESERVE_BETWEEN_CARDS_MAX=80
OZON_SESSION_MIN=20
OZON_SESSION_MAX=50
OZON_ANTIBOT_STREAK_THRESHOLD=3
OZON_ANTIBOT_COOLDOWN_S=600
OZON_MIN_RATING=4.8
OZON_MIN_REVIEWS=30
OZON_POOL_MULTIPLIER=3
OZON_MAX_PAGES=10
PARSER_ROLE=primary

# Redis
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_BRPOP_TIMEOUT_S=2
REDIS_RECONNECT_DELAY_S=5
PARSER_ID=1

# --- Политика Wildberries (независима от Ozon)
WB_HEADLESS=false
WB_PAGE_LOAD_TIMEOUT=30
WB_WAIT_TIMEOUT=20
WB_PAUSE_MIN=3
WB_PAUSE_MAX=6
WB_RETRIES=2
WB_RETRY_PAUSE_MIN=30
WB_RETRY_PAUSE_MAX=60
WB_BETWEEN_CARDS_MIN=60
WB_BETWEEN_CARDS_MAX=80
WB_RESERVE_BETWEEN_CARDS_MIN=50
WB_RESERVE_BETWEEN_CARDS_MAX=80
WB_SESSION_MIN=20
WB_SESSION_MAX=50
WB_ANTIBOT_STREAK_THRESHOLD=3
WB_ANTIBOT_COOLDOWN_S=600
WB_MIN_RATING=4.8
WB_MIN_REVIEWS=30
WB_POOL_MULTIPLIER=3
WB_MAX_PAGES=10
