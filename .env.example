# Режим
DEBUG=false
LOG_LEVEL=INFO
DEBUG_DIR=app/debug
API_PREFIX=/api/v1

# Ключ межсервисной авторизации
SERVICE_API_KEY=string

# Redis
OZON_GEO_CODE=spb
OZON_GEO_NAME=Санкт-Петербург
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_BRPOP_TIMEOUT_S=2
REDIS_RECONNECT_DELAY_S=5
PARSER_ID=1

# --- Политика Ozon
OZON_HEADLESS=true
OZON_PAGE_LOAD_TIMEOUT=30
OZON_WAIT_TIMEOUT=15
OZON_PAUSE_MIN=2.0
OZON_PAUSE_MAX=4.0
OZON_RETRIES=3
OZON_MAX_PAGES=10
OZON_MIN_RATING=4.8
OZON_MIN_REVIEWS=100
OZON_RETRY_PAUSE_MIN=20.0
OZON_RETRY_PAUSE_MAX=40.0
