# Режим
DEBUG=false
LOG_LEVEL=INFO
DEBUG_DIR=app/debug
API_PREFIX=/api/v1

# Ключ межсервисной авторизации
SERVICE_API_KEY=string

PARSER_MARKETPLACES=ozon

OZON_GEO_CODE=spb
OZON_GEO_NAME=Санкт-Петербург

# --- Политика Ozon
OZON_HEADLESS=false
OZON_PAGE_LOAD_TIMEOUT=30
OZON_WAIT_TIMEOUT=15
OZON_PAUSE_MIN=15
OZON_PAUSE_MAX=30
OZON_RETRIES=2
OZON_RETRY_PAUSE_MIN=60.0
OZON_RETRY_PAUSE_MAX=80.0
OZON_BETWEEN_CARDS_MIN=50
OZON_BETWEEN_CARDS_MAX=90
OZON_RESERVE_BETWEEN_CARDS_MIN=50
OZON_RESERVE_BETWEEN_CARDS_MAX=80
OZON_SESSION_MIN=20
OZON_SESSION_MAX=50
OZON_LOAD_FAILURE_THRESHOLD=3
OZON_BAN_PAUSE_START_S=600
OZON_BAN_PAUSE_MAX_S=7200
OZON_BAN_LEVEL_RESET_S=21600
OZON_BLOCK_ARTIFACTS_KEEP=50
OZON_MIN_RATING=4.8
OZON_MIN_REVIEWS=30
OZON_POOL_MULTIPLIER=3
OZON_MAX_PAGES=10
OZON_SEARCH_TILES_TARGET=32
OZON_SEARCH_MAX_SCROLLS=10
OZON_SEARCH_TASK_MAX_AGE_S=21600
# Подмены отпечатка WebGL: spoof — строка видеокарты профиля; native — SwiftShader без подмены; off — выключен
OZON_FP_WEBGL=spoof
OZON_FP_TOSTRING_PROXY=true
OZON_FP_CLIENT_HINTS=true
PARSER_ROLE=primary

# Redis
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_BRPOP_TIMEOUT_S=2
REDIS_RECONNECT_DELAY_S=5
PARSER_ID=1
